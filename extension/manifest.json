{
  "manifest_version": 3,
  "name": "Recipe Extractor",
  "version": "0.1.0",
  "description": "Extract, save, edit, and scale recipes from TikTok and Instagram.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "action": {
    "default_title": "Recipe Extractor",
    "default_popup": "popup.html"
  }
}
